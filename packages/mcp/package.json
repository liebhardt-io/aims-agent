  },
  "devDependencies": {
    "@ai-media-studio/core": "workspace:^",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
