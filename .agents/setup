#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

echo "[setup] Checking the orb's Node.js runtime"
node -e 'if (Number(process.versions.node.split(".")[0]) < 18) { console.error("Node.js >=18 is required"); process.exit(1) }'
node --version

pnpm_version="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
echo "[setup] Ensuring pnpm@$pnpm_version"
if ! command -v pnpm >/dev/null 2>&1 || [[ "$(pnpm --version)" != "$pnpm_version" ]]; then
  time npm install --global "pnpm@$pnpm_version" --no-audit --no-fund
fi

echo "[setup] Installing locked workspace dependencies"
time CI=1 NODE_ENV=development pnpm install --frozen-lockfile

echo "[setup] Building core, CLI, and MCP packages"
time pnpm build

echo "[setup] Ready in ${SECONDS}s (no API credentials required)"
